# Copy to .env for local development. Every value has a safe default.

# memory | redis
LEADERBOARD_STORE_BACKEND=memory
LEADERBOARD_REDIS_URL=redis://localhost:6379/0
LEADERBOARD_REDIS_MAX_CONNECTIONS=50

LEADERBOARD_ENVIRONMENT=local
LEADERBOARD_LOG_LEVEL=INFO
# json for production, console for readable local output
LEADERBOARD_LOG_FORMAT=console

LEADERBOARD_MIN_SCORE=0
LEADERBOARD_MAX_SCORE=1000000000
LEADERBOARD_MAX_PAGE_SIZE=1000
LEADERBOARD_MAX_CONTEXT_RADIUS=50

LEADERBOARD_DAILY_TTL_SECONDS=691200
LEADERBOARD_WEEKLY_TTL_SECONDS=3024000
LEADERBOARD_IDEMPOTENCY_TTL_SECONDS=86400

LEADERBOARD_CORS_ALLOW_ORIGINS=*
LEADERBOARD_DOCS_ENABLED=true
